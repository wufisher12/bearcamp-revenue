# Raw collection intermediates stay local. The sheet export carries property
# addresses and every other tab of the workbook, none of which belongs in a
# repo that serves a public site. Only site/data/ is published.
/data/

# Email drafts are working documents for Mike's review, never published.
/drafts/

# Secrets. NOTE: naming a file "*.gitignore" does NOT make git ignore it -
# only a file named exactly ".gitignore" is special. These are explicit.
.env
.env.*
*.env
WHEELHOUSE_API_KEY*
*api_key*
*apikey*
*secret*
*credentials*
*service-account*.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
